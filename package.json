{
  "name": "discord-github-ticket-relay",
  "version": "0.1.0",
  "description": "Let people submit tickets through Discord and relay them to the right GitHub repository as issues.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && cp -R src/db/migrations dist/db/ && cp -R src/web/public dist/web/",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "start:triage": "node dist/triage-worker.js",
    "migrate": "tsx src/db/migrate-cli.ts",
    "migrate:prod": "node dist/db/migrate-cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juansebsol/discord-github-ticket-relay.git"
  },
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/juansebsol/discord-github-ticket-relay/issues"
  },
  "homepage": "https://github.com/juansebsol/discord-github-ticket-relay#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/formbody": "^9.0.1",
    "@fastify/multipart": "10.1.2",
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "pino": "^10.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "lucide-static": "0.460.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
