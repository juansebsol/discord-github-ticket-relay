# ---- Required --------------------------------------------------------------------------
# SQLite database file, shared by the web and worker processes (directory is created).
DATABASE_PATH=./data/ticket-relay.db
# Public HTTPS address of this deployment (used for OAuth callbacks and the Discord endpoint).
PUBLIC_URL=http://localhost:3000
# 32 random bytes, base64. Encrypts stored tokens and ticket text. Generate: openssl rand -base64 32
# Keep it stable: changing it makes stored encrypted data unreadable.
ENCRYPTION_KEY=

# ---- Discord application (Developer Portal) ---------------------------------------------
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# ---- GitHub App -------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Private key file: download it from the GitHub App page (Private keys → Generate a private key),
# rename it to sec.pem and put it in the secrets/ folder (git-ignored). Then: chmod 600 secrets/sec.pem
GITHUB_APP_PRIVATE_KEY_FILE=./secrets/sec.pem
# Alternative to the file: the key as one base64 line (base64 -w0 sec.pem). Leave unset when using the file.
# GITHUB_APP_PRIVATE_KEY=
# Optional: enables the webhook that reports uninstall/suspend immediately.
GITHUB_WEBHOOK_SECRET=

# ---- Access -----------------------------------------------------------------------------
# Comma-separated Discord user IDs allowed to create workspaces. If empty, only the very
# first person to sign in can create one; everyone else needs an invitation.
PLATFORM_ADMIN_DISCORD_IDS=
# Set to true to let anyone who signs in create their own isolated workspace.
OPEN_WORKSPACE_CREATION=false

# ---- Runtime (optional) -----------------------------------------------------------------
# PORT=3000
# HOST=0.0.0.0
# RUN_WORKER=true        # in-process worker; ecosystem.config.cjs sets false and runs dedicated workers
# WORKER_CONCURRENCY=2   # tickets each worker process files in parallel
# AUTO_MIGRATE=true      # apply database migrations on startup
# TRUST_PROXY=true       # behind a reverse proxy / load balancer
# LOG_LEVEL=info
# DEV_LOGIN=true         # local development only: sign in without Discord (ignored in production)
